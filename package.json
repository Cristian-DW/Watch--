{
  "name": "watch",
  "version": "0.1.0",
  "description": "WATCH — Plataforma de monitoreo de información de Internet",
  "repository": "",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap/cds": "^9",
    "@sap/xssec": "^4",
    "express": "^4",
    "nodemailer": "^7.0.13"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1",
    "@cap-js/sqlite": "^2",
    "@sap/cds-dk": "^9",
    "@sap/ux-specification": "latest",
    "jest": "^29"
  },
  "scripts": {
    "start": "cds-serve",
    "dev": "cds watch",
    "build": "cds build --production",
    "test": "npx jest --silent"
  },
  "cds": {
    "requires": {
      "db": "sql",
      "html5-repo": true,
      "[development]": {
        "auth": "dummy"
      },
      "[production]": {
        "auth": "xsuaa"
      }
    },
    "watch": {
      "currency": "COP",
      "checkOnCreate": true,
      "scheduler": {
        "enabled": true,
        "tickSeconds": 60,
        "maxWatchesPerTick": 10
      },
      "matching": {
        "minScore": 0.75,
        "outlierRatio": 0.35
      },
      "notifications": {
        "email": {
          "enabled": true,
          "from": "WATCH <no-reply@watch.local>"
        }
      },
      "providers": {
        "remotive": {
          "enabled": true
        },
        "arbeitnow": {
          "enabled": true
        },
        "serpapi-google-jobs": {
          "enabled": true,
          "hl": "es"
        },
        "jsearch": {
          "enabled": true,
          "datePosted": "week"
        },
        "mercadolibre": {
          "enabled": true,
          "site": "MCO"
        },
        "serpapi-google-shopping": {
          "enabled": true,
          "gl": "co",
          "hl": "es"
        },
        "mock-jobs": {
          "enabled": false
        },
        "mock-shop": {
          "enabled": false
        }
      },
      "[development]": {
        "providers": {
          "mock-jobs": {
            "enabled": true,
            "newEveryMinutes": 15
          },
          "mock-shop": {
            "enabled": true,
            "repriceMinutes": 30
          }
        }
      },
      "[test]": {
        "checkOnCreate": false,
        "scheduler": {
          "enabled": false
        },
        "providers": {
          "remotive": {
            "enabled": false
          },
          "arbeitnow": {
            "enabled": false
          },
          "serpapi-google-jobs": {
            "enabled": false
          },
          "jsearch": {
            "enabled": false
          },
          "mercadolibre": {
            "enabled": false
          },
          "serpapi-google-shopping": {
            "enabled": false
          },
          "mock-jobs": {
            "enabled": false
          },
          "mock-shop": {
            "enabled": false
          }
        }
      }
    }
  },
  "sapux": [
    "app/watches"
  ]
}
