<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:form="sap.ui.layout.form"
  core:require="{ formatter: 'watch/watches/model/formatter' }">

  <Dialog
    id="createWatchDialog"
    title="{i18n>dialogCreateTitle}"
    contentWidth="560px"
    type="Message">

    <content>
      <VBox class="sapUiSmallMargin">
        <MessageStrip
          text="{i18n>helperQuickSuggest}"
          type="Information"
          showIcon="true"
          class="sapUiSmallMarginBottom" />

        <form:SimpleForm
          id="createWatchForm"
          editable="true"
          layout="ResponsiveGridLayout"
          labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12"
          emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0"
          columnsXL="1" columnsL="1" columnsM="1">

          <form:content>
            <Label text="{i18n>labelType}" />
            <Select id="selectType" selectedKey="PRODUCT" change="onCreateTypeChange">
              <core:Item key="PRODUCT" text="{i18n>type.PRODUCT}" />
              <core:Item key="JOB"     text="{i18n>type.JOB}" />
              <core:Item key="PRICE"   text="{i18n>type.PRICE}" />
              <core:Item key="STOCK"   text="{i18n>type.STOCK}" />
              <core:Item key="CONTENT" text="{i18n>type.CONTENT}" />
              <core:Item key="CUSTOM"  text="{i18n>type.CUSTOM}" />
            </Select>

            <Label text="{i18n>labelName}" required="true" />
            <Input
              id="inputName"
              placeholder="{i18n>placeholderQuickSuggest}"
              showSuggestion="true"
              startSuggestion="1"
              filterSuggests="false"
              suggest="onWatchSuggest"
              suggestionItemSelected="onSuggestionSelected"
              liveChange="onNameLiveChange"
              suggestionRows="{ui>/suggestions}">
              <suggestionColumns>
                <Column width="45%"><Label text="{i18n>colName}" /></Column>
                <Column width="35%"><Label text="{i18n>colCategory}" /></Column>
                <Column width="20%" hAlign="End"><Label text="{i18n>colType}" /></Column>
              </suggestionColumns>
              <suggestionRows>
                <ColumnListItem>
                  <cells>
                    <ObjectIdentifier title="{ui>title}" text="{ui>description}" />
                    <Text text="{path: 'ui>category', formatter: 'formatter.categoryText'} · {ui>subcategory}" />
                    <ObjectStatus
                      text="{path: 'ui>type', formatter: 'formatter.typeText'}"
                      icon="{path: 'ui>type', formatter: 'formatter.typeIcon'}"
                      state="Information" />
                  </cells>
                </ColumnListItem>
              </suggestionRows>
            </Input>

            <Label text="{i18n>labelCategory}" />
            <Select id="selectCategory">
              <core:Item key="PROD_FOOTWEAR"     text="{i18n>category.PROD_FOOTWEAR}" />
              <core:Item key="PROD_TECH"         text="{i18n>category.PROD_TECH}" />
              <core:Item key="PROD_GAMING"       text="{i18n>category.PROD_GAMING}" />
              <core:Item key="PROD_HOME"         text="{i18n>category.PROD_HOME}" />
              <core:Item key="PROD_FASHION"      text="{i18n>category.PROD_FASHION}" />
              <core:Item key="PROD_SPORTS"       text="{i18n>category.PROD_SPORTS}" />
              <core:Item key="JOB_SAP_ERP"       text="{i18n>category.JOB_SAP_ERP}" />
              <core:Item key="JOB_SOFTWARE_DEV"  text="{i18n>category.JOB_SOFTWARE_DEV}" />
              <core:Item key="JOB_CLOUD_DEVOPS"  text="{i18n>category.JOB_CLOUD_DEVOPS}" />
              <core:Item key="JOB_DATA_AI"       text="{i18n>category.JOB_DATA_AI}" />
              <core:Item key="JOB_CYBERSECURITY" text="{i18n>category.JOB_CYBERSECURITY}" />
              <core:Item key="JOB_PRODUCT_AGILE" text="{i18n>category.JOB_PRODUCT_AGILE}" />
              <core:Item key="OTHER"             text="{i18n>category.OTHER}" />
            </Select>

            <Label text="{i18n>labelSubcategory}" />
            <Input id="inputSubcategory" placeholder="{i18n>placeholderSubcategory}" />

            <Label text="{i18n>labelQuery}" visible="{ui>/createForm/isSearch}" />
            <Input id="inputQuery" placeholder="{i18n>placeholderQuery}" visible="{ui>/createForm/isSearch}" />

            <Label text="{i18n>labelLocation}" visible="{ui>/createForm/isJob}" />
            <Input id="inputLocation" placeholder="{i18n>placeholderLocation}" visible="{ui>/createForm/isJob}" />

            <Label text="{i18n>labelTargetPrice}" visible="{ui>/createForm/isProduct}" />
            <Input id="inputTargetPrice" type="Number" placeholder="{i18n>placeholderTargetPrice}" visible="{ui>/createForm/isProduct}" />

            <Label text="{i18n>labelCurrency}" visible="{ui>/createForm/isProduct}" />
            <Select id="selectCurrency" selectedKey="COP" visible="{ui>/createForm/isProduct}">
              <core:Item key="COP" text="COP — Peso Colombiano" />
              <core:Item key="USD" text="USD — US Dollar" />
              <core:Item key="EUR" text="EUR — Euro" />
              <core:Item key="MXN" text="MXN — Peso Mexicano" />
            </Select>

            <Label text="{i18n>labelUrl}" required="{ui>/createForm/isUrlRequired}" />
            <Input id="inputUrl" type="Url" placeholder="{i18n>placeholderUrl}"
              liveChange="onUrlLiveChange" />

            <Label text="{i18n>labelNotifyEmail}" />
            <Input id="inputNotifyEmail" type="Email" placeholder="{i18n>placeholderNotifyEmail}" />

            <Label text="{i18n>labelCondition}" visible="{ui>/createForm/isUrlRequired}" />
            <Input id="inputCondition" placeholder="{i18n>placeholderCondition}" visible="{ui>/createForm/isUrlRequired}" />

            <Label text="{i18n>labelFrequency}" />
            <Select id="selectFrequency" selectedKey="DAILY">
              <core:Item key="HOURLY" text="{i18n>frequency.HOURLY}" />
              <core:Item key="DAILY"  text="{i18n>frequency.DAILY}" />
              <core:Item key="WEEKLY" text="{i18n>frequency.WEEKLY}" />
            </Select>
          </form:content>

        </form:SimpleForm>
      </VBox>
    </content>

    <beginButton>
      <Button
        id="btnDialogCreate"
        text="{i18n>btnCreate}"
        type="Emphasized"
        press=".onDialogCreatePress" />
    </beginButton>

    <endButton>
      <Button
        id="btnDialogCancel"
        text="{i18n>btnCancel}"
        press=".onDialogCancelPress" />
    </endButton>

  </Dialog>

</core:FragmentDefinition>
