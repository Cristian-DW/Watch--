<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:form="sap.ui.layout.form">

  <Dialog
    id="createWatchDialog"
    title="{i18n>dialogCreateTitle}"
    contentWidth="480px"
    type="Message">

    <content>
      <form:SimpleForm
        id="createWatchForm"
        editable="true"
        layout="ResponsiveGridLayout"
        labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12"
        emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0"
        columnsXL="1" columnsL="1" columnsM="1">

        <form:content>
          <Label text="{i18n>labelName}" required="true" />
          <Input id="inputName" placeholder="{i18n>placeholderName}"
            liveChange="onNameLiveChange" />

          <Label text="{i18n>labelUrl}" required="true" />
          <Input id="inputUrl" type="Url" placeholder="{i18n>placeholderUrl}"
            liveChange="onUrlLiveChange" />

          <Label text="{i18n>labelType}" />
          <Select id="selectType" selectedKey="PRICE">
            <core:Item key="PRICE"   text="{i18n>type.PRICE}" />
            <core:Item key="STOCK"   text="{i18n>type.STOCK}" />
            <core:Item key="CONTENT" text="{i18n>type.CONTENT}" />
            <core:Item key="CUSTOM"  text="{i18n>type.CUSTOM}" />
          </Select>

          <Label text="{i18n>labelCondition}" />
          <Input id="inputCondition" placeholder="{i18n>placeholderCondition}" />

          <Label text="{i18n>labelFrequency}" />
          <Select id="selectFrequency" selectedKey="DAILY">
            <core:Item key="HOURLY" text="{i18n>frequency.HOURLY}" />
            <core:Item key="DAILY"  text="{i18n>frequency.DAILY}" />
            <core:Item key="WEEKLY" text="{i18n>frequency.WEEKLY}" />
          </Select>
        </form:content>

      </form:SimpleForm>
    </content>

    <beginButton>
      <Button
        id="btnDialogCreate"
        text="{i18n>btnCreate}"
        type="Emphasized"
        press=".onDialogCreatePress" />
    </beginButton>

    <endButton>
      <Button
        id="btnDialogCancel"
        text="{i18n>btnCancel}"
        press=".onDialogCancelPress" />
    </endButton>

  </Dialog>

</core:FragmentDefinition>
