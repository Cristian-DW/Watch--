{
  "_version": "1.65.0",
  "sap.app": {
    "id": "watch.watches",
    "type": "application",
    "title": "WATCH — Monitors",
    "description": "Gestión de Watches para monitoreo de información en Internet",
    "applicationVersion": {
      "version": "0.1.0"
    },
    "dataSources": {
      "WatchService": {
        "uri": "/api/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ui.layout": {},
        "sap.f": {},
        "sap.ui.table": {}
      }
    },
    "models": {
      "": {
        "dataSource": "WatchService",
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        },
        "type": "sap.ui.model.odata.v4.ODataModel"
      }
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "type": "View",
        "viewType": "XML",
        "viewPath": "watch.watches.view",
        "controlId": "app",
        "controlAggregation": "pages"
      },
      "routes": [
        {
          "name": "WatchList",
          "pattern": "",
          "target": "WatchList"
        }
      ],
      "targets": {
        "WatchList": {
          "viewName": "WatchList",
          "viewLevel": 1
        }
      }
    },
    "rootView": {
      "viewName": "watch.watches.view.App",
      "type": "XML",
      "id": "app"
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    }
  }
}
