{
  "_version": "1.65.0",
  "sap.app": {
    "id": "watch.watches",
    "type": "application",
    "i18n": {
      "bundleName": "watch.watches.i18n.i18n",
      "supportedLocales": ["es", "en"],
      "fallbackLocale": "es"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "applicationVersion": {
      "version": "0.1.0"
    },
    "dataSources": {
      "WatchService": {
        "uri": "/api/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ui.layout": {},
        "sap.f": {},
        "sap.ui.table": {}
      }
    },
    "resources": {
      "css": [
        { "uri": "css/style.css" }
      ]
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "watch.watches.i18n.i18n",
          "supportedLocales": ["es", "en"],
          "fallbackLocale": "es"
        }
      },
      "": {
        "dataSource": "WatchService",
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        },
        "type": "sap.ui.model.odata.v4.ODataModel"
      }
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "type": "View",
        "async": true,
        "viewType": "XML",
        "viewPath": "watch.watches.view",
        "controlId": "app",
        "controlAggregation": "pages"
      },
      "routes": [
        {
          "name": "WatchList",
          "pattern": "",
          "target": "WatchList"
        },
        {
          "name": "WatchDetail",
          "pattern": "watch/{id}",
          "target": "WatchDetail"
        }
      ],
      "targets": {
        "WatchList": {
          "viewName": "WatchList",
          "viewLevel": 1
        },
        "WatchDetail": {
          "viewName": "WatchDetail",
          "viewLevel": 2
        }
      }
    },
    "rootView": {
      "viewName": "watch.watches.view.App",
      "type": "XML",
      "id": "app"
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    }
  }
}
